{
  "name": "devops-pipelines",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal Node.js example for learning CI/CD pipelines.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:example": "node index.js --config devops.config.example.json",
    "start:example:json": "node index.js --config devops.config.example.json --format json",
    "start:local": "node index.js --config devops.config.local.json",
    "start:json": "node index.js --format json",
    "start:ndjson": "node index.js --format ndjson",
    "run": "node index.js",
    "check": "node --check index.js && node --check test.js",
    "validate:schema": "node -e \"JSON.parse(require('node:fs').readFileSync('devops.config.schema.json', 'utf8'))\"",
    "validate:config": "node index.js --validate-config",
    "validate": "npm run check && npm run validate:schema && npm run validate:config -- --config devops.config.example.json && npm test",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mati54866/devops_pipeline.git"
  },
  "keywords": [
    "devops",
    "ci-cd",
    "github-actions"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Mati54866/devops_pipeline/issues"
  },
  "homepage": "https://github.com/Mati54866/devops_pipeline"
}
