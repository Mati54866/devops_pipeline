# Optional default name used when --name is not provided.
DEVOPS_GREETING_NAME=CI

# Optional path to a JSON configuration file.
# DEVOPS_CONFIG=devops.config.local.json

# Optional output format: text, json, or ndjson.
# DEVOPS_FORMAT=json

# Optional separator for text output.
# DEVOPS_SEPARATOR= | 

# Optional casing override: true or false.
# DEVOPS_UPPERCASE=false

# Optional JSON array of extra messages.
# DEVOPS_MESSAGES=["Build complete","Ready to deploy"]
